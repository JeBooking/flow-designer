<?xml version='1.0' encoding='cp936'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" id="Definitions_CommunicationRetry" targetNamespace="http://diagnosis.local/examples">
  <bpmn:process id="CommunicationRetry" name="通信诊断：有上限的重试环" isExecutable="false">
    <bpmn:startEvent id="Start" name="开始">
      <bpmn:outgoing>L_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="LinkCheck" name="异步检查连接并判断" flowable:diagnosisKind="investigation" flowable:pythonModule="diagnostic_demo.scenarios" flowable:pythonFunction="check_link" flowable:pythonArguments="{&quot;context&quot;: &quot;$&quot;, &quot;scenario&quot;: &quot;$scenario&quot;}" flowable:observation="通道连接状态及累计检查次数" flowable:acquisition="异步调用模拟连接接口；计数保存在 LinkCheck 流程变量中。" flowable:assessment="蓝线取 0 表示失败、1 表示成功；红线为 0.5。失败三次后上升，禁止无限重试。" flowable:referenceImage="data:image/png;base64,">
      <bpmn:incoming>L_start</bpmn:incoming>
      <bpmn:outgoing>L_retry</bpmn:outgoing>
      <bpmn:incoming>L_reset</bpmn:incoming>
      <bpmn:outgoing>L_ready</bpmn:outgoing>
      <bpmn:outgoing>L_escalate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="RetryAction" name="复位通信通道（模拟）" flowable:diagnosisKind="investigationAction" flowable:pythonModule="diagnostic_demo.scenarios" flowable:pythonFunction="reset_link" flowable:pythonArguments="{}" flowable:actionText="只执行模拟通道复位；随后回到排查节点判断连接，最多检查三次。">
      <bpmn:incoming>L_retry</bpmn:incoming>
      <bpmn:outgoing>L_reset</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="LinkConclusion" name="连接恢复" flowable:diagnosisKind="conclusion" flowable:pythonModule="diagnostic_demo.scenarios" flowable:pythonFunction="link_conclusion" flowable:pythonArguments="{&quot;reading&quot;: &quot;$LinkCheck&quot;}" flowable:conclusionText="连接已建立，记录成功前的检查次数。">
      <bpmn:incoming>L_ready</bpmn:incoming>
      <bpmn:outgoing>L_confirm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Acknowledge" name="确认恢复并结束" flowable:diagnosisKind="remediation" flowable:pythonModule="diagnostic_demo.scenarios" flowable:pythonFunction="acknowledge_link" flowable:pythonArguments="{&quot;conclusion&quot;: &quot;$LinkConclusion&quot;}">
      <bpmn:incoming>L_confirm</bpmn:incoming>
      <bpmn:outgoing>L_done</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Solved" name="问题解决" flowable:diagnosisKind="problemSolved">
      <bpmn:incoming>L_done</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Escalation" name="上升" flowable:diagnosisKind="escalation">
      <bpmn:incoming>L_escalate</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="L_start" sourceRef="Start" targetRef="LinkCheck" name="" />
    <bpmn:sequenceFlow id="L_retry" sourceRef="LinkCheck" targetRef="RetryAction" name="未连接且不足三次" />
    <bpmn:sequenceFlow id="L_reset" sourceRef="RetryAction" targetRef="LinkCheck" name="再次排查" />
    <bpmn:sequenceFlow id="L_ready" sourceRef="LinkCheck" targetRef="LinkConclusion" name="连接成功" />
    <bpmn:sequenceFlow id="L_escalate" sourceRef="LinkCheck" targetRef="Escalation" name="三次仍失败" />
    <bpmn:sequenceFlow id="L_confirm" sourceRef="LinkConclusion" targetRef="Acknowledge" name="" />
    <bpmn:sequenceFlow id="L_done" sourceRef="Acknowledge" targetRef="Solved" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="CommunicationRetry_diagram">
    <bpmndi:BPMNPlane id="CommunicationRetry_plane" bpmnElement="CommunicationRetry">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="80" y="285" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LinkCheck_di" bpmnElement="LinkCheck">
        <dc:Bounds x="190" y="260" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RetryAction_di" bpmnElement="RetryAction">
        <dc:Bounds x="190" y="60" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LinkConclusion_di" bpmnElement="LinkConclusion">
        <dc:Bounds x="490" y="260" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Acknowledge_di" bpmnElement="Acknowledge">
        <dc:Bounds x="770" y="260" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Solved_di" bpmnElement="Solved">
        <dc:Bounds x="1040" y="260" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Escalation_di" bpmnElement="Escalation">
        <dc:Bounds x="490" y="470" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="L_start_di" bpmnElement="L_start">
        <di:waypoint x="116" y="303.0" />
        <di:waypoint x="190" y="303.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L_retry_di" bpmnElement="L_retry">
        <di:waypoint x="275" y="260" />
        <di:waypoint x="275" y="146" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="235.0" y="179.0" width="80" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L_reset_di" bpmnElement="L_reset">
        <di:waypoint x="190" y="103" />
        <di:waypoint x="150" y="103" />
        <di:waypoint x="150" y="303" />
        <di:waypoint x="190" y="303" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="130.0" y="79.0" width="80" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L_ready_di" bpmnElement="L_ready">
        <di:waypoint x="360" y="303.0" />
        <di:waypoint x="490" y="303.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="385.0" y="279.0" width="80" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L_escalate_di" bpmnElement="L_escalate">
        <di:waypoint x="275" y="346" />
        <di:waypoint x="275" y="513" />
        <di:waypoint x="490" y="513" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="235.0" y="405.5" width="80" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L_confirm_di" bpmnElement="L_confirm">
        <di:waypoint x="660" y="303.0" />
        <di:waypoint x="770" y="303.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="L_done_di" bpmnElement="L_done">
        <di:waypoint x="940" y="303.0" />
        <di:waypoint x="1040" y="303.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>