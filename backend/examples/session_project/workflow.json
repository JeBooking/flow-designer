{
  "version": 4,
  "process": { "id": "DeviceSession", "name": "设备电压恢复示例" },
  "mode": "parallel",
  "start": "Start",
  "nodes": {
    "Start": {
      "kind": "start",
      "outgoing": [{ "id": "Start_Ready", "target": "Ready" }]
    },
    "Ready": {
      "kind": "investigation",
      "detailText": "确认设备会话已初始化，进入电压采集。",
      "nameMode": "auto",
      "observation": "设备会话是否可用。",
      "acquisition": "调用 Device.ready。",
      "assessment": "返回 True 时进入采集。",
      "referenceImage": "assets/voltage-reference.txt",
      "pythonModule": "device_session",
      "pythonFactory": "Device",
      "pythonFunction": "ready",
      "outgoing": [{ "id": "Ready_Collect", "target": "reading", "branch": "yes" }]
    },
    "reading": {
      "kind": "investigationAction",
      "detailText": "采集设备电压，保存原始 Reading 对象供后续判断使用。",
      "nameMode": "auto",
      "pythonModule": "device_session",
      "pythonFactory": "Device",
      "pythonFunction": "collect",
      "outgoing": [{ "id": "Collect_Check", "target": "Check" }]
    },
    "Check": {
      "kind": "investigation",
      "detailText": "判断采集到的电压是否低于设定阈值。",
      "nameMode": "auto",
      "observation": "Reading 对象中的 voltage。",
      "acquisition": "接收 reading 节点返回的原始对象。",
      "assessment": "调用 Device.is_low；低于 threshold 返回 True。",
      "referenceImage": "assets/voltage-reference.txt",
      "pythonModule": "device_session",
      "pythonFactory": "Device",
      "pythonFunction": "is_low",
      "outgoing": [{ "id": "Check_Conclusion", "target": "Conclusion", "branch": "yes" }]
    },
    "Conclusion": {
      "kind": "conclusion",
      "detailText": "设备电压低于设定阈值，尝试恢复后复核。",
      "nameMode": "auto",
      "outgoing": [{ "id": "Conclusion_Repair", "target": "Repair" }]
    },
    "Repair": {
      "kind": "remediation",
      "detailText": "执行模拟恢复，并在同一设备实例上重新采集和复核；复核失败则报错。",
      "nameMode": "auto",
      "pythonModule": "device_session",
      "pythonFactory": "Device",
      "pythonFunction": "restore_and_verify",
      "outgoing": [{ "id": "Repair_Solved", "target": "Solved" }]
    },
    "Solved": {
      "kind": "problemSolved",
      "detailText": "恢复后的电压已通过复核，本次排查完成。",
      "nameMode": "auto"
    }
  },
  "resources": [{ "path": "assets/voltage-reference.txt", "mediaType": "text/plain" }]
}
